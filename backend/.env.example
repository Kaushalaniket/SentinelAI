# Optional environment variables for the SentinelAI backend.
# Copy this file to `.env` (or export the variables in your shell) and edit.
# Nothing here is required - the application runs fully without them.

# --- Threat intelligence (optional) -------------------------------------
# When set, IP lookups query this provider live and fall back to the built-in
# offline blocklist if the request fails. When unset, ONLY the offline
# blocklist is used and the UI labels the result as "cached / offline".
# Get a key at https://www.abuseipdb.com/api
ABUSEIPDB_API_KEY=

# Get a key at https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# --- Threat-intelligence feed -------------------------------------------
# Keyless public blocklist used as the offline fallback.
# SENTINELAI_TI_FEED_URL=https://raw.githubusercontent.com/stamparm/ipsum/master/ipsum.txt
# How long the cached copy is trusted before a re-download is attempted.
# SENTINELAI_TI_FEED_MAX_AGE=168

# --- Paths / server -----------------------------------------------------
# SENTINELAI_DB=/absolute/path/to/sentinelai.db
# SENTINELAI_MODEL=/absolute/path/to/model.joblib
# SENTINELAI_CORS=http://localhost:5173,http://127.0.0.1:5173

# --- Training knobs (only used by `python -m app.ml.train`) -------------
# SENTINELAI_SEED=42
# SENTINELAI_N_ESTIMATORS=128
# SENTINELAI_MAX_LEAF_NODES=1024
