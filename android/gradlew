#!/bin/bash
#
# Gradle start up script for POSIX generated by Gradle.
#
# This script should be run with the same user as the project.
#
# SPDX-License-Identifier: Apache-2.0
#

# Attempt to set the project's location absolute
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
PROJECT_DIR="$(cd -P "$DIR/.." >/dev/null 2>&1 && pwd)"
export GRADLE_USER_HOME="$PROJECT_DIR/.gradle"
export JAVA_OPTS="${JAVA_OPTS:--Xmx2048m}"

exec java ${JAVA_OPTS} -jar "$DIR/gradle/wrapper/gradle-wrapper.jar" "$@"
